# Local (docker compose)
DB_HOST=db
DB_PORT=5432
DB_NAME=nobb
DB_USER=nobb
DB_PASS=nobb
DB_SSLMODE=disable
APP_ENV=local

# Supabase (put these in Vercel's environment settings instead).
# Copy the pooler host, port and user from Supabase: Project, then Connect.
# DB_HOST=<pooler host>
# DB_PORT=6543
# DB_NAME=postgres
# DB_USER=<user shown by Supabase>
# DB_PASS=<your database password>
# DB_SSLMODE=require
# APP_ENV=production